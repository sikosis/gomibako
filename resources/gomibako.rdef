resource app_signature "application/x-vnd.sikosis-gomibako";

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major = 0,
	middle = 2,
	minor = 5,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "gomibako v0.25",
	long_info = "gomibako Deskbar Trash manager"
};

resource(101, "BEOS:L:STD_ICON") #'ICON' import "icon-32.icon";
resource(101, "BEOS:M:STD_ICON") #'MICN' import "icon-16.icon";
resource(100, "about-icon.png") #'PNG ' import "icon.png";
